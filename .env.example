APP_NAME=Finobe
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://finobe.wtf

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.finobe.wtf
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# use phpredis if predis does not work
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.spacemail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@finobe.wtf
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@finobe.wtf"
MAIL_FROM_NAME="Finobe"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Mail: FINOBE_MAIL_MODE 1=ZeptoMail, 2=SMTP2GO, 3=SMTP (e.g. Spaceship Spacemail)
FINOBE_MAIL_MODE=3
FINOBE_ERACAST_API_KEY=
FINOBE_ERACAST_CONNECT_KEY=
# optional: .ROBLOSECURITY cookie of an alt Roblox account. Some items (mostly newer ones) can only be
# downloaded by a logged-in account; without it the item importer / copier says so for those items.
# Use an alt, never your main account.
FINOBE_ROBLOSECURITY=
# where Roblox assets are downloaded from when importing/copying items (default: roproxy)
FINOBE_ASSETDELIVERY=https://assetdelivery.roproxy.com
# python used to convert compressed (7.00) meshes from UGC items; needs `pip install DracoPy`
FINOBE_PYTHON=python3
FINOBE_DOMAIN=finobe.wtf

# Public blog, served by the same Laravel public directory on its own hostname.
BLOG_URL=https://blog.finobe.wtf
BLOG_TWITTER_URL=
FINOBE_CDN_PATH=/var/www/cdn.finobe.wtf

# RCC / arbiter (see tools/rcc/README.md)
FINOBE_ARBITER_HOST=127.0.0.1
FINOBE_ARBITER_PORT=64989
FINOBE_GAMESERVER_HOST=
FINOBE_GAMESERVER_PORT_MIN=53640
FINOBE_GAMESERVER_PORT_MAX=53740
FINOBE_CLOUD_AUTHORIZATION=

# Feature switches (true = on)
FINOBE_CREATE_ASSETS=true
FINOBE_CREATE_PLACES=true
FINOBE_FORUM_POST=true
# sign-up is only open when invite keys are on; users then need a key to register
FINOBE_INVITE_KEYS=true
FINOBE_CREATE_INVITE_KEYS=true

# client build the launcher downloads from prod1-setup (files: storage/setup or storage/app/private/setup)
FINOBE_CLIENT_VERSION=version-xqs0ranlc9ofKJwiJtSd

# 2012 game servers: address of tools/gameserver2012/host2012.ps1 on the game server machine (private), e.g. http://10.0.0.5:64990
FINOBE_HOST2012_URL=
# other years' builds for the launcher (tools/client/package_client.py <folder> --year <year> prints the value)
FINOBE_CLIENT_VERSION_2012=

# Settings > Name Change: price in Dius and days between changes
FINOBE_NAME_CHANGE_COST=150
FINOBE_NAME_CHANGE_COOLDOWN_DAYS=0
FINOBE_SERVER_NAME=
