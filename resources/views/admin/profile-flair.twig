{% if data.admin_flair.title or data.admin_flair.effect or data.admin_flair.accent %}
<link rel="stylesheet" href="/s/admin/profile-flair.css">
<div class="finobe-flair finobe-flair-{{ data.admin_flair.effect|e('html_attr') }}"{% if data.admin_flair.accent %} style="--flair-accent:{{ data.admin_flair.accent|e('html_attr') }}"{% endif %}>
{% if data.admin_flair.effect == 'party' %}<span class="finobe-party" aria-label="Party hat">◭</span>{% endif %}
{% if data.admin_flair.title %}<span>{{ data.admin_flair.title|e }}</span>{% else %}<span>Finobe member</span>{% endif %}
</div>
{% endif %}
