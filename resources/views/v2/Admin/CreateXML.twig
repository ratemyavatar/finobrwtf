<html>
  <head>
    {% include ('v2/Modules/head.twig') %}
    <style>
        .form-group {
            margin-bottom: 15px;
        }
</style>
  </head>
  <body>
    <div id="app">
      {% include ('v2/Modules/nav.twig') %}
      <div class="container mt-3">
		<h3>Create item</h3>
		<form role="form" method="POST" action="" id="dynamic-form" enctype="multipart/form-data">
            <input type="hidden" name="_token" value="{{ data.csrf_token }}">
            <div class="form-group row">
                <label for="title" class="col-form-label text-md-right" style="margin-left:15px;">Title</label>
                <div class="col-md-12">
                    <input type="text" name="title" value="" placeholder="title" autofocus="autofocus" class="form-control" required>
                </div>
            </div>
			<div class="form-group row">
                <label for="description" class="col-form-label text-md-right" style="margin-left:15px;">Description</label>
                <div class="col-md-12">
                    <textarea name="description" value="" placeholder="description" class="form-control"></textarea>
                </div>
            </div>
            <div class="form-group row">
                <label for="price" class="col-form-label text-md-right" style="margin-left:15px;">Price</label>
                <div class="col-md-12">
                    <input type="number" name="price" value="0" min="0" placeholder="price" class="form-control">
                </div>
            </div>
            <div class="form-group row">
                <label for="type" class="col-form-label text-md-right" style="margin-left:15px;">Asset type</label>
                <div class="col-md-12">
                    <select id="type" name="type" required="" class="form-control" onchange="showFileField()">
                        <option value="hat">Hat / Accessory</option>
                        <option value="gear">Gear</option>
                        <option value="face">Face</option>
                        <option value="shirt">Shirt</option>
                        <option value="pants">Pants</option>
                        <option value="tshirt">T-Shirt</option>
                        <option value="mesh">Mesh</option>
                        <option value="texture">Texture</option>
                    </select>
                </div>
            </div>
            <div class="custom-control custom-checkbox mt-3">
                <input type="checkbox" name="onsale" id="onsale" class="custom-control-input">
                <label for="onsale" class="custom-control-label pl-1">On sale</label>
            </div>
            <div class="form-group row mt-3 upload-field" data-for="hat gear">
                <label for="rbxm" class="col-form-label text-md-right" style="margin-left:15px;">Model (.rbxm / .rbxmx)</label>
                <div class="col-md-12">
                    <input type="file" id="rbxm" name="rbxm" accept=".rbxm,.rbxmx" class="form-control">
                    <small class="text-muted">In Studio: right click the Accessory or Tool, "Save to File". Its mesh and texture are downloaded from Roblox and converted automatically.</small>
                </div>
            </div>
            <div class="form-group row mt-3 upload-field" data-for="face shirt pants tshirt texture">
                <label for="image" class="col-form-label text-md-right" style="margin-left:15px;">Image (.png)</label>
                <div class="col-md-12">
                    <input type="file" id="image" name="image" accept="image/png,image/jpeg" class="form-control">
                    <small class="text-muted">Faces: the face picture on a transparent background. Shirts / pants: the clothing template.</small>
                </div>
            </div>
            <div class="form-group row mt-3 upload-field" data-for="mesh">
                <label for="mesh" class="col-form-label text-md-right" style="margin-left:15px;">Mesh</label>
                <div class="col-md-12">
                    <input type="file" id="mesh" name="mesh" class="form-control">
                </div>
            </div>
            <script>
                function showFileField() {
                    const type = document.getElementById('type').value;
                    document.querySelectorAll('.upload-field').forEach(el => {
                        el.style.display = el.dataset.for.split(' ').includes(type) ? '' : 'none';
                    });
                }
                showFileField();
</script>
            <div class="form-group" style="margin-top:40px;">
                <button type="submit" class="btn btn-success full-width">create</button>
            </div>
        </form>
	  </div>
    </div>
    {% include ('v2/Modules/footer.twig') %}
  </body>
</html>