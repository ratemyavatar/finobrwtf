{% extends 'v2/Admin/_layout.twig' %}
{% block tool %}
<p class="text-muted">No Dius, no cooldown. Everything with their name on it follows the new name.</p>
<form method="POST" style="max-width: 480px;">
  <input type="hidden" name="_token" value="{{ data.csrf_token }}">
  <div class="form-group"><label for="user"><strong>Username</strong></label><input type="text" id="user" name="user" class="form-control" required></div>
  <div class="form-group"><label for="new_username"><strong>New Name</strong></label><input type="text" id="new_username" name="new_username" class="form-control" required maxlength="30"></div>
  <button class="btn btn-primary">change</button>
</form>
{% endblock %}
