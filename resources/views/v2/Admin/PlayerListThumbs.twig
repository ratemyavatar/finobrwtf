{% extends 'v2/Admin/_layout.twig' %}
{% block tool %}
<form method="GET" class="form-inline mb-3">
  <input type="text" name="user" class="form-control mr-2 mb-2" placeholder="Username" value="{{ data.search }}">
  <button class="btn btn-secondary mb-2">search</button>
</form>
<div class="row">
  {% for u in data.users %}
  <div class="col-6 col-md-3 col-lg-2 mb-3 text-center">
    <img src="/thumbs/avatar-headshot.ashx?userId={{ u.id }}" alt="{{ u.username }}" style="width: 64px; height: 64px; object-fit: contain;">
    <p class="mb-1 text-truncate"><a href="/user/{{ u.id }}">{{ u.username }}</a></p>
    <form method="POST" class="mb-0"><input type="hidden" name="_token" value="{{ data.csrf_token }}"><input type="hidden" name="user" value="{{ u.id }}"><button class="btn btn-sm btn-outline-primary">regen</button></form>
  </div>
  {% endfor %}
</div>
{% endblock %}
