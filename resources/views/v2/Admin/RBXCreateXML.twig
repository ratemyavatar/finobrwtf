<html>
  <head>
    {% include ('v2/Modules/head.twig') %}
    <style>
        .form-group {
            margin-bottom: 15px;
        }
    </style>
  </head>
  <body>
    <div id="app">
      {% include ('v2/Modules/nav.twig') %}
      <div class="container mt-3">
		<h3>Copy a Roblox item</h3>
		<form role="form" method="POST" action="" id="dynamic-form" enctype="multipart/form-data">
            <input type="hidden" name="_token" value="{{ data.csrf_token }}">
            <div class="form-group row">
                <label for="link" class="col-form-label text-md-right" style="margin-left:15px;">Roblox item link</label>
                <div class="col-md-12">
                    <input type="text" id="link" name="link" value="" placeholder="https://www.roblox.com/catalog/1772336109/Down-to-Earth-Hair" autofocus="autofocus" class="form-control" required>
                    <small class="text-muted">Hats, accessories, gear, faces, shirts, pants, t-shirts, heads and bundles. Name, description and type are taken from Roblox. A bundle link (roblox.com/bundles/...) becomes a package of the items inside it.</small>
                </div>
            </div>
            <div class="form-group row">
                <label for="title" class="col-form-label text-md-right" style="margin-left:15px;">Title (optional)</label>
                <div class="col-md-12">
                    <input type="text" id="title" name="title" value="" placeholder="same as on Roblox" class="form-control">
                </div>
            </div>
            <div class="form-group row">
                <label for="description" class="col-form-label text-md-right" style="margin-left:15px;">Description (optional)</label>
                <div class="col-md-12">
                    <textarea id="description" name="description" placeholder="same as on Roblox" class="form-control"></textarea>
                </div>
            </div>
            <div class="form-group row">
                <label for="price" class="col-form-label text-md-right" style="margin-left:15px;">Price</label>
                <div class="col-md-12">
                    <input type="number" id="price" name="price" value="0" min="0" class="form-control">
                </div>
            </div>
            <div class="custom-control custom-checkbox mt-3">
                <input type="checkbox" name="onsale" id="onsale" class="custom-control-input">
                <label for="onsale" class="custom-control-label pl-1">On sale</label>
            </div>
            <div class="form-group" style="margin-top:40px;">
                <button type="submit" class="btn btn-success full-width">copy</button>
            </div>
        </form>
	  </div>
    </div>
    {% include ('v2/Modules/footer.twig') %}
  </body>
</html>