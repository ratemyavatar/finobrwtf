<html>
  <head>
    {% include ('v2/Modules/head.twig') %}
  </head>
  <body>
    <div id="app">
      {% include ('v2/Modules/nav.twig') %}
      <div class="forum-section-info mb-4 text-center py-4"><h4 class="mb-2">{% if data.search %}Search{% elseif not data.section %}All Sections{% else %}{{ data.forum_sections[data.section].name ?? "" }}{% endif %}</h4> <p class="mt-2 mb-0 text-muted">{% if data.search %}you search for stuff here{% elseif not data.section %}This section of the forum consolidates all of the latest forum posts on the forum.{% else %}{{ data.forum_sections[data.section].about ?? "" }}{% endif %}</p></div>
            <div class="container"><div class="row"><div class="col-md-4 col-lg-2 mb-4"><a href="/app/forum/new/post" class="btn btn-outline-primary btn-block mt-2 mb-4"><i class="far fa-plus mr-1"></i>
                    New Topic				</a> <form method="get" action="/forum/search" class="mt-2 mb-4"><div class="input-group search-input"><input type="text" name="q" placeholder="Search..." value="" class="form-control form-control-sm border-right-0 border"> <span class="input-group-append"><button type="submit" class="btn btn-outline-secondary btn-sm border-left-0 border"><i class="far fa-search"></i></button></span></div></form> <nav class="finobe-basic-nav"><p class="header">Section</p> <a href="/forum/home" class="link{{ (not data.section) ? " active" : "" }}">
            All Sections
        </a> {% for id, section in data.forum_sections %}<a href="/forum/home/{{ id }}" class="link{{ (data.section == id) ? " active" : "" }}"><span class="forum__color-ball" style="background: rgb({{ section.color }});"></span>
            {{ section.name }}
        </a> {% endfor %}</nav></div> <div class="col-md-8 col-lg-10">
            {% if data.search %}
                <h3>Results for <strong>{{ data.search }}</h3></strong>
            {% endif %}
            <div class="forum-posts mb-4">
            {% for thread in data.threads.data %}
                <a href="/forum/post?id={{ thread.id }}" class="forum-post overflow-hidden"><span><p class="mt-0 mb-1"><strong{{ ((thread.pinned and thread.pinned != 'n')) ? ' class="text-success"' : ''}}>{% if (thread.locked and thread.locked != 'n') %}<i class="far fa-lock mr-1"></i>{% endif %}{% if (thread.pinned and thread.pinned != 'n') %}<i class="far fa-thumbtack mr-1"></i>{% endif %}<span>{{ thread.title | raw }}</span> <span class="badge forum-badge ml-1 text-white" style="background: rgb({{ data.forum_sections[thread.category].color ?? "96, 104, 111" }});">
                {{ data.forum_sections[thread.category].name ?? "" }}
						</span></strong></p>
                        <p class="my-0">Posted by <span{{ (thread.status == "admin") ? ' class="text-danger" style="font-weight: bold;"' : ""}}>{{ thread.author }}</span> <span title="{{ thread.date }}">{{ thread.ago }}</span></p> <p class="my-0 text-muted"><span title="Post score" class="mr-1 forum-vote-total">
                        {{ thread.rating }}
                    </span>
                    {{ thread.replies }} {{ thread.replies == 1 ? "reply" : "replies" }}
                </p></span></a>
            {% endfor %}
            {% if not data.threads.data|length %}
                <p>No results</p>
            {% endif %}
            </div>
            <div class="mt-2" style="display: flex; justify-content: center;">
                <ul class="pagination shadow-sm">
    <li class="page-item{{ (data.threads.pages.info.previous_page == data.threads.pages.info.start_page) ? " disabled" : "" }}">
      <a class="page-link" id="previous-page" href="/forum/{{ (not data.search) ? "home" : "search" }}{{ (data.section != "0") ? "/" ~ data.section : "" }}{{ (data.search) ? "?q=" ~ data.search : "" }}{{ (data.search) ? "&" : "?" }}page={{ data.threads.pages.info.previous_page }}" rel="previous" aria-label="Previous <<" {{ (data.threads.pages.info.current_page <= 1) ? "style='pointer-events: none;'" : "" }}>«</a>
    </li>
    {% if data.threads.pages.info.start_page > 1 %}
      <li class="page-item">
        <a class="page-link" href="/forum/{{ (not data.search) ? "home" : "search" }}{{ (data.section != "0") ? "/" ~ section : "" }}{{ (data.search) ? "?q=" ~ data.search : "" }}{{ (data.search) ? "&" : "?" }}page=1">1</a>
      </li>
      {% if data.threads.pages.info.start_page > 2 %}
        <li class="page-item">
          <a class="page-link" href="/forum/{{ (not data.search) ? "home" : "search" }}{{ (data.section != "0") ? "/" ~ section : "" }}{{ (data.search) ? "?q=" ~ data.search : "" }}{{ (data.search) ? "&" : "?" }}page=2">2</a>
        </li>
      {% endif %}
      {% if data.threads.pages.info.start_page - 1 > 2 %}
        <li class="page-item"><span class="page-link">...</span></li>
      {% endif %}
    {% endif %}
    {% for page in data.threads.pages.data %}
      <li class="page-item">
        <a class="page-link{{ (page.page == data.threads.pages.info.current_page) ? " selected" : "" }}" href="/forum/{{ (not data.search) ? "home" : "search" }}{{ (data.section != "0") ? "/" ~ data.section : "" }}{{ (data.search) ? "?q=" ~ data.search : "" }}{{ (data.search) ? "&" : "?" }}page={{ page.page }}">
          {{ page.page }}
        </a>
      </li>
    {% endfor %}
    {% if data.threads.pages.info.end_page < data.threads.pages.info.number_of_pages %}
      {% if data.threads.pages.info.end_page + 1 < data.threads.pages.info.number_of_pages - 1 %}
        <li class="page-item"><span class="page-link">...</span></li>
      {% endif %}
      {% for page in [data.threads.pages.info.number_of_pages - 1, data.threads.pages.info.number_of_pages] %}
        {% if page > data.threads.pages.info.end_page %}
          <li class="page-item">
            <a class="page-link" href="/forum/{{ (not data.search) ? "home" : "search" }}{{ (data.section != "0") ? "/" ~ data.section : "" }}{{ (data.search) ? "?q=" ~ data.search : "" }}{{ (data.search) ? "&" : "?" }}page={{ page }}">{{ page }}</a>
          </li>
        {% endif %}
      {% endfor %}
    {% endif %}
    <li class="page-item{{ (data.threads.pages.info.next_page == data.threads.pages.info.end_page) ? " disabled" : "" }}">
      <a class="page-link" id="next-page" href="/forum/{{ (data.search) ? "home" : "search" }}{{ (data.section != "0") ? "/" ~ data.section : "" }}{{ (data.search) ? "?q=" ~ data.search : "" }}{{ (data.search) ? "&" : "?" }}page={{ data.threads.pages.info.next_page }}" rel="next" aria-label="Next >>" >»</a>
    </li>
  </ul>
            </div>
        </div>
    {% include ('v2/Modules/footer.twig') %}
  </body>
</html>