{% if item is defined and item.kind is defined and item.kind %}
<div class="d-flex justify-content-between align-items-start" style="margin-bottom:-28px;position:relative;z-index:2;">
	<div>
		{% if item.kind == 'unique' %}<span class="badge badge-warning text-white">Unique</span>{% if item.serial > 0 %} <span class="badge text-white" style="background-color:#a855c8;">{{ item.serial }}</span>{% endif %}{% else %}<span class="badge badge-success">Limited</span>{% endif %}
	</div>
	{% if item.kind == 'unique' and item.serial > 0 %}
	<div class="dropdown">
		<button class="btn btn-sm text-white" style="background-color:#4b4f54;border-color:#4b4f54;" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"><i class="fas fa-bars"></i></button>
		<div class="dropdown-menu dropdown-menu-right">
			<a class="dropdown-item" href="/item/sell/{{ item.id }}">Sell</a>
		</div>
	</div>
	{% endif %}
</div>
{% endif %}
