                <script>
                  $(document).ready(function() {
                    var time = '{{ data.user.lastdiu }}';

                    var userTimezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
                    var userLocalTime = new Date(time);
                    var userLocalOffset = userLocalTime.getTimezoneOffset();
                    userLocalTime = new Date(userLocalTime.getTime() - userLocalOffset);

                    function updateCountdown() {
                      var targetDate = userLocalTime.getTime();
                      var now = new Date().getTime();
                      var distance = targetDate - now;

                      if (distance <= 0) {
                        clearInterval(interval);
						if($('[x-placement="bottom"]').find('.tooltip-inner').text().includes(' left')) {
                        	$('[x-placement="bottom"]').find('.tooltip-inner').text('{{ data.user.Dius|number_format }} - 0 hr(s) 0 min(s) 0 sec(s) left');
						}
						$('[title="Diu"]').attr('data-original-title', '{{ data.user.Dius|number_format }} - 0 hr(s) 0 min(s) 0 sec(s) left');
                        return;
                      }

                      var hours = Math.abs(Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)));
                      var minutes = Math.abs(Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60)));
                      var seconds = Math.abs(Math.floor((distance % (1000 * 60)) / 1000));

                      var countdownText = hours + ' hr(s) ' + minutes + ' min(s) ' + seconds + ' sec(s) left';

					  if($('[x-placement="bottom"]').find('.tooltip-inner').text().includes(' left')) {
                      	$('[x-placement="bottom"]').find('.tooltip-inner').text("{{ data.user.Dius|number_format }} - " + countdownText);
					  }
					  $('[data-original-title="Diu"]').attr('data-original-title', '{{ data.user.Dius|number_format }} - ' + countdownText);
					  $('#test[data-toggle="tooltip"]').attr('data-original-title', '{{ data.user.Dius|number_format }} - ' + countdownText);
                    }

                    var interval = setInterval(updateCountdown, 1000);
                    updateCountdown();
                  });
</script>
				<li id="test" data-animation="false" data-toggle="tooltip" data-placement="bottom" title="Diu" data-original-title="{{ data.user.Dius|number_format }} - 0 hr(s) 0 min(s) 0 sec(s) left" class="nav-item n-money-text" ><a href="/user/transaction-log" class="nav-link"><img src="/s/img/diu_16.png" "alt="Diu" title="Diu" class="img-responsive align-middle "> {{ data.user.formattedDius }}</a></li>
