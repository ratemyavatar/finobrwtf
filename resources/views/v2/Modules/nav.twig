	<p class="mb-0" style="color: white;">{{ announcement.message | raw }}</p>
</div>
{% endfor %}
{% if data.alerts.successv2 %}
<div class="text-center alert alert-success alert-logged" role="alert" style="z-index:1;">
	<div class="container success-container" style="color:white;">
		<button type="button" id="x" class="close" onclick="" data-dismiss="alert" aria-hidden="true">×</button>
			{{ data.alerts.successv2 }}
	</div>
</div>
<script>
	$(document).ready(function() {
    $("#x").click(function() {
      $(".alert-logged").fadeOut(300);
    });
	});
</script>
{% endif %}
