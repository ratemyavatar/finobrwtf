                            <p class="mb-1"><a href="#general" class="settings-tab" data-pane="general">General</a></p>
                            <p class="mb-1"><a href="#badges" class="settings-tab" data-pane="badges">Badges</a></p>
                            <p class="mb-1"><a href="#restrictions" class="settings-tab" data-pane="restrictions">User Restrictions</a></p>
                            <p class="mb-1"><a href="#thumbnail" class="settings-tab" data-pane="thumbnail">Thumbnail</a></p>
                        </div>
                    </div>
                    <div class="col-lg-10 mb-2">
                        <div class="settings-pane" id="pane-general">
                        <form role="form" method="POST" action="" enctype="multipart/form-data">
                            <input type="hidden" name="_token" value="{{ data.csrf_token }}">
                            <div class="form-group">
                                <h4 style="font-weight: 300;"><strong>Edit</strong> <a href="/place/{{ data.place.id }}">{{ data.place.title|raw }}</a></h4>
                                <p class="col-form-label">
                                    <strong>General</strong>
                                </p>
                                <label for="name" class="col-form-label text-md-right">
                                    <strong>Name</strong>
                                </label>
                                <div class="full-width">
                                    <input type="text" name="title" value="{{ data.place.title|raw }}" placeholder="Place title"
                                        class="form-control"><br>
                                </div>
                                <label for="description" class="col-form-label text-md-right">
                                    <strong>Description</strong>
                                </label>
                                <div class="full-width">
                                    <textarea type="text" name="description" value="" placeholder="description"
                                        class="form-control">{{ data.place.description }}</textarea>
                                </div>
                                <div class="custom-control custom-checkbox mt-3"><input type="checkbox" id="visibility" name="allowplaying" class="custom-control-input"{{ (data.place.additional.allowplaying) ? " checked" : "" }}> <label for="visibility" class="custom-control-label pl-1">Allow playing of this place</label></div>
                                <div class="custom-control custom-checkbox mt-3"><input type="checkbox" id="downloadable" name="downloadable" class="custom-control-input"{{ (data.place.additional.uncopylocked) ? " checked" : "" }}> <label for="downloadable" class="custom-control-label pl-1">Uncopylocked</label></div>
                                <small id="downloadable" class="form-text text-muted" style="margin-left:3%">Enabling this option will allow your place file to be downloaded by anybody</small>
                                <div class="custom-control custom-checkbox mt-3"><input type="checkbox" id="hideRecent" name="hideRecent" class="custom-control-input"{{ (data.place.additional.hidden) ? " checked" : "" }}> <label for="hideRecent" class="custom-control-label pl-1">Hide from recent places list</label></div>
                                <small id="hideRecent" class="form-text text-muted" style="margin-left:3%">Enabling this will hide your place from the place list unless te user explicitly checked the "Show hidden places" option.</small>
                                <p class="col-form-label">
                                    <strong>Gear Types</strong>
                                </p>
                                <div class="d-flex mb-2">
                                    <div>
                                        <div data-v-4350f98c="" class="custom-control custom-checkbox"><input data-v-4350f98c="" type="checkbox" id="combat" name="combat" class="custom-control-input"{{ (data.place.additional.gears.combat) ? " checked" : "" }}> <label data-v-4350f98c="" for="combat" class="custom-control-label pl-1">Combat</label></div>
                                        <div data-v-4350f98c="" class="custom-control custom-checkbox mt-3"><input data-v-4350f98c="" type="checkbox" id="social" name="social" class="custom-control-input"{{ (data.place.additional.gears.social) ? " checked" : "" }}> <label data-v-4350f98c="" for="social" class="custom-control-label pl-1">Social</label></div>
                                    </div>
                                    <div style="margin-left: 10%">
                                        <div data-v-4350f98c="" class="custom-control custom-checkbox"><input data-v-4350f98c="" type="checkbox" id="building" name="building" class="custom-control-input"{{ (data.place.additional.gears.building) ? " checked" : "" }}> <label data-v-4350f98c="" for="building" class="custom-control-label pl-1">Building</label></div>
                                        <div data-v-4350f98c="" class="custom-control custom-checkbox mt-3"><input data-v-4350f98c="" type="checkbox" id="musical" name="musical" class="custom-control-input"{{ (data.place.additional.gears.musical) ? " checked" : "" }}> <label data-v-4350f98c="" for="musical" class="custom-control-label pl-1">Musical</label></div>
                                    </div>
                                </div>
                                <p class="col-form-label">
                                    <strong>Chat Type</strong>
                                </p>
                                <div class="custom-control custom-radio"><input type="radio" id="type-classic" name="chat-type" value="classic" class="custom-control-input"{{ (data.place.additional.chat_type == "classic") ? " checked" : "" }}> <label data-v-4350f98c="" for="type-classic" class="custom-control-label pl-1">Classic</label></div>
                                <div data-v-4350f98c="" class="custom-control custom-radio"><input data-v-4350f98c="" type="radio" id="type-bubble-chat" name="chat-type" class="custom-control-input" value="bubble_chat"{{ (data.place.additional.chat_type == "bubble_chat") ? " checked" : "" }}> <label data-v-4350f98c="" for="type-bubble-chat" class="custom-control-label pl-1">Bubble Chat</label></div>
                                <div data-v-4350f98c="" class="custom-control custom-radio"><input data-v-4350f98c="" type="radio" id="type-both" name="chat-type" class="custom-control-input" value="both"{{ (data.place.additional.chat_type == "both") ? " checked" : "" }}> <label data-v-4350f98c="" for="type-both" class="custom-control-label pl-1">Both</label></div>
                                <p class="col-form-label mt-3 mb-0 py-0">
                                    <strong>Category</strong>
                                </p>
                                <small class="form-text text-muted mt-0">This is the category that your place will be listed under on the place list. If you falsely categorize your place, you may have your place slots revoked and even be banned.</small>
                                <div class="custom-control custom-radio"><input type="radio" id="category-original" name="category" class="custom-control-input" value="original"{{ (data.place.additional.category == "original") ? " checked" : "" }}> <label for="category-original" class="custom-control-label pl-1">Original</label></div>
                                <small id="category-original" class="form-text text-muted" style="margin-left:3%">Choose this option if your place is something you've made yourself, and not a copy.</small>
                                <div class="custom-control custom-radio"><input type="radio" id="category-copy" name="category" class="custom-control-input" value="copy"{{ (data.place.additional.category == "copy") ? " checked" : "" }}> <label for="category-copy" class="custom-control-label pl-1">Copy (Non-original)</label></div>
                                <small id="category-copy" class="form-text text-muted" style="margin-left:3%">Choose this option if your is a copy of an existing game or a modified game or a modified existing game.</small>
                                <p class="col-form-label mt-2">
                                    <strong>Max Players</strong>
                                </p>
                                <select name="max-players" class="form-control">
                                    <option value="5"{{ (data.place.additional.maxplayers == 5) ? " selected" : "" }}>5</option>
                                    <option value="10"{{ (data.place.additional.maxplayers == 10) ? " selected" : "" }}>10</option>
                                    <option value="15"{{ (data.place.additional.maxplayers == 15) ? " selected" : "" }}>15</option>
                                    <option value="20"{{ (data.place.additional.maxplayers == 20) ? " selected" : "" }}>20</option>
                                    <option value="25"{{ (data.place.additional.maxplayers == 25) ? " selected" : "" }}>25</option>
                                    <option value="30"{{ (data.place.additional.maxplayers == 30) ? " selected" : "" }}>30</option>
                                    <option value="35"{{ (data.place.additional.maxplayers == 35) ? " selected" : "" }}>35</option>
                                    <option value="40"{{ (data.place.additional.maxplayers == 40) ? " selected" : "" }}>40</option>
                                    <option value="45"{{ (data.place.additional.maxplayers == 45) ? " selected" : "" }}>45</option>
                                    <option value="50"{{ (data.place.additional.maxplayers == 50) ? " selected" : "" }}>50</option>
                                    <option value="55"{{ (data.place.additional.maxplayers == 55) ? " selected" : "" }}>55</option>
                                    <option value="60"{{ (data.place.additional.maxplayers == 60) ? " selected" : "" }}>60</option>
                                    <option value="65"{{ (data.place.additional.maxplayers == 65) ? " selected" : "" }}>65</option>
                                    <option value="70"{{ (data.place.additional.maxplayers == 70) ? " selected" : "" }}>70</option>
                                    <option value="75"{{ (data.place.additional.maxplayers == 75) ? " selected" : "" }}>75</option>
                                    <option value="80"{{ (data.place.additional.maxplayers == 80) ? " selected" : "" }}>80</option>
                                    <option value="85"{{ (data.place.additional.maxplayers == 85) ? " selected" : "" }}>85</option>
                                    <option value="90"{{ (data.place.additional.maxplayers == 90) ? " selected" : "" }}>90</option>
                                    <option value="95"{{ (data.place.additional.maxplayers == 95) ? " selected" : "" }}>95</option>
                                    <option value="100"{{ (data.place.additional.maxplayers == 100) ? " selected" : "" }}>100</option>
                                </select>
                                <p class="col-form-label mt-2">
                                    <strong>Version</strong>
                                </p>
                                {% for v in client_versions %}
                                <div data-v-4350f98c="" class="custom-control custom-radio"><input data-v-4350f98c="" type="radio" id="version-{{ v }}" name="game-version" class="custom-control-input" value="{{ v }}"{{ ((data.place.additional.version ?: "2016") == v) ? " checked" : "" }}> <label data-v-4350f98c="" for="version-{{ v }}" class="custom-control-label pl-1">{{ v }}</label></div>
                                {% endfor %}
                                <small class="form-text text-muted mt-0">The place file isn't converted: only switch if it was made in that year's Studio (or upload one that was).</small>
                                <button type="submit" class="btn btn-primary mt-3">update</button>
                            </div>
                        </form>
                        <hr>
                        <p class="col-form-label"><strong>Place file</strong></p>
                        <p class="text-muted mb-2">Built your game in Studio? Upload the .rbxl or .rbxlx here and it replaces what's in your game right now.{% if data.place.file_size %} Current file: {{ data.place.file_size }} (<a href="https://www.finobe.wtf/asset/?id={{ data.place.id }}">download</a>).{% endif %}</p>
                        <form role="form" method="POST" action="" enctype="multipart/form-data">
                            <input type="hidden" name="_token" value="{{ data.csrf_token }}">
                            <input type="hidden" name="action" value="upload_place">
                            <input type="file" name="place_file" accept=".rbxl,.rbxlx" class="form-control" required>
                            <small class="form-text text-muted">Up to 50 MB. Save a 2012 game from a 2012 Studio so it opens in the 2012 client.</small>
                            <button type="submit" class="btn btn-primary mt-2">Upload place</button>
                        </form>
                        <form role="form" method="POST" action="" class="mt-3" onsubmit="return confirm('Wipe your place back to an empty baseplate? This can\'t be undone.');">
                            <input type="hidden" name="_token" value="{{ data.csrf_token }}">
                            <input type="hidden" name="action" value="reset_place">
                            <button type="submit" class="btn btn-outline-danger btn-sm">Reset to baseplate</button>
                        </form>
                        </div>
                        <div class="settings-pane" id="pane-thumbnail" style="display:none">
                            <h4 style="font-weight: 300;"><strong>Thumbnail</strong></h4>
                            <p class="text-muted">This is what people see on the games page.{% if data.place.custom_thumbnail %} You're using your own picture right now.{% else %} It's a picture of your place taken by our game server.{% endif %}</p>
                            <img src="{{ data.place.thumbnail }}" alt="Thumbnail" class="mb-3" style="max-width: 100%; width: 480px; height: auto; border-radius: 4px;">
                            {% if data.place.pending_thumbnail %}
                                <div class="alert alert-info">Your uploaded thumbnail is waiting for a moderator. It'll swap in once it's approved.</div>
                            {% endif %}
                            <p class="col-form-label"><strong>Upload your own</strong></p>
                            <form role="form" method="POST" action="" enctype="multipart/form-data">
                                <input type="hidden" name="_token" value="{{ data.csrf_token }}">
                                <input type="hidden" name="action" value="upload_thumbnail">
                                <input type="file" name="thumbnail" accept=".png,.jpg,.jpeg" class="form-control" required>
                                <small class="form-text text-muted">PNG or JPG, at least 320x180 (16:9 looks best), up to 5 MB. A moderator has to approve it first, so keep it clean.</small>
                                <button type="submit" class="btn btn-primary mt-2">Upload</button>
                            </form>
                            <p class="col-form-label mt-3"><strong>Take a new picture</strong></p>
                            <form role="form" method="POST" action="">
                                <input type="hidden" name="_token" value="{{ data.csrf_token }}">
                                <input type="hidden" name="regen_thumbnail" value="1">
                                <small class="form-text text-muted mb-2">Changed your place? Have the game server snap a fresh picture of it.{% if data.place.custom_thumbnail %} This replaces your uploaded one.{% endif %}</small>
                                <button type="submit" class="btn btn-secondary">Re-render thumbnail</button>
                            </form>
                        </div>
                        <div class="settings-pane" id="pane-badges" style="display:none">
                            <h4 style="font-weight: 300;"><strong>Badges</strong></h4>
                            <p class="text-muted">Give players badges for doing stuff in your game. In a script on the server, call <code>game:GetService("BadgeService"):AwardBadge(player.userId, BADGE_ID)</code>.</p>
                            {% if data.place.badges|length %}
                                {% for badge in data.place.badges %}
                                    <div class="d-flex align-items-center mb-3">
                                        <img src="{{ badge.icon }}" alt="" style="width: 64px; height: 64px; object-fit: cover; border-radius: 50%; margin-right: 12px;">
                                        <div class="flex-grow-1">
                                            <p class="mb-0"><strong>{{ badge.name }}</strong> <small class="text-muted">ID {{ badge.id }}</small></p>
                                            {% if badge.description %}<p class="mb-0 text-muted">{{ badge.description }}</p>{% endif %}
                                            <small class="{{ badge.status == 'approved' ? 'text-success' : (badge.status == 'denied' ? 'text-danger' : 'text-muted') }}">{{ badge.status }}</small>
                                            <small class="text-muted"> &middot; won by {{ badge.awarded }} {{ badge.awarded == 1 ? 'player' : 'players' }}</small>
                                        </div>
                                        <form role="form" method="POST" action="" onsubmit="return confirm('Delete this badge? Players who have it will lose it.');">
                                            <input type="hidden" name="_token" value="{{ data.csrf_token }}">
                                            <input type="hidden" name="action" value="delete_badge">
                                            <input type="hidden" name="badge_id" value="{{ badge.id }}">
                                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                        </form>
                                    </div>
                                {% endfor %}
                            {% else %}
                                <p class="text-muted">No badges yet.</p>
                            {% endif %}
                            <p class="col-form-label mt-2"><strong>Make a badge</strong></p>
                            <form role="form" method="POST" action="" enctype="multipart/form-data">
                                <input type="hidden" name="_token" value="{{ data.csrf_token }}">
                                <input type="hidden" name="action" value="create_badge">
                                <input type="text" name="badge_name" maxlength="50" placeholder="Badge name" class="form-control mb-2" required>
                                <textarea name="badge_description" maxlength="1000" placeholder="What do you have to do to get it? (optional)" class="form-control mb-2"></textarea>
                                <input type="file" name="badge_icon" accept=".png,.jpg,.jpeg" class="form-control" required>
                                <small class="form-text text-muted">Icon: PNG or JPG, square, at least 64x64, up to 2 MB. It shows up as a circle. A moderator approves it before the badge works.</small>
                                <button type="submit" class="btn btn-primary mt-2">Make badge</button>
                            </form>
                        </div>
                        <div class="settings-pane" id="pane-restrictions" style="display:none">
                            <h4 style="font-weight: 300;"><strong>User Restrictions</strong></h4>
                            <p class="text-muted">Pick who's allowed to join your game. You can always join it yourself.</p>
                            <form role="form" method="POST" action="">
                                <input type="hidden" name="_token" value="{{ data.csrf_token }}">
                                <input type="hidden" name="action" value="save_restrictions">
                                <p class="col-form-label"><strong>Who can join</strong></p>
                                <div class="custom-control custom-radio"><input type="radio" id="access-everyone" name="access" value="everyone" class="custom-control-input"{{ data.place.restrictions.access == 'everyone' ? ' checked' : '' }}> <label for="access-everyone" class="custom-control-label">Everyone</label></div>
                                <div class="custom-control custom-radio"><input type="radio" id="access-friends" name="access" value="friends" class="custom-control-input"{{ data.place.restrictions.access == 'friends' ? ' checked' : '' }}> <label for="access-friends" class="custom-control-label">Only my friends</label></div>
                                <div class="custom-control custom-radio"><input type="radio" id="access-me" name="access" value="me" class="custom-control-input"{{ data.place.restrictions.access == 'me' ? ' checked' : '' }}> <label for="access-me" class="custom-control-label">Just me (good for testing)</label></div>
                                <p class="col-form-label mt-3"><strong>Minimum account age</strong></p>
                                <div class="d-flex align-items-center" style="max-width: 260px;">
                                    <input type="number" name="min_account_age" min="0" max="3650" value="{{ data.place.restrictions.min_account_age }}" class="form-control mr-2">
                                    <span class="text-nowrap">days</span>
                                </div>
                                <small class="form-text text-muted">Keeps brand new alts out. 0 means anyone.</small>
                                <p class="col-form-label mt-3"><strong>Blocked players</strong></p>
                                <textarea name="blocked" placeholder="usernames, separated by commas" class="form-control">{{ data.place.restrictions.blocked_names }}</textarea>
                                <small class="form-text text-muted">These people can't join your game at all.</small>
                                <button type="submit" class="btn btn-primary mt-3">Save</button>
                            </form>
                        </div>
                        <script>
                            (function () {
                                function show(name) {
                                    if (!document.getElementById('pane-' + name)) name = 'general';
                                    document.querySelectorAll('.settings-pane').forEach(function (p) { p.style.display = p.id === 'pane-' + name ? '' : 'none'; });
                                    document.querySelectorAll('.settings-tab').forEach(function (a) {
                                        var on = a.getAttribute('data-pane') === name;
                                        a.classList.toggle('text-primary', on);
                                        a.style.fontWeight = on ? 'bold' : '';
                                        a.style.color = on ? '' : 'inherit';
                                    });
                                }
                                document.querySelectorAll('.settings-tab').forEach(function (a) {
                                    a.addEventListener('click', function (e) { e.preventDefault(); history.replaceState(null, '', '#' + a.getAttribute('data-pane')); show(a.getAttribute('data-pane')); });
                                });
                                show((location.hash || '#general').slice(1));
                            })();
                        </script>
                    </div>
                </div>
            </div>
    </div>
    {% include ('v2/Modules/footer.twig') %}
  </body>
</html>