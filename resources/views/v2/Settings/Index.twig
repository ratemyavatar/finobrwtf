<html>
  <head>
    {% include ('v2/Modules/head.twig') %}
	<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-modal/0.9.1/jquery.modal.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-modal/0.9.1/jquery.modal.min.css" />
  </head>
  <body>
    <div id="app">
      {% include ('v2/Modules/nav.twig') %}
      <style>
                .close-modal {
                    left: 100%;
                }
                /* jquery-modal (the e-mail box) styles every .modal; undo that for the Bootstrap one */
                #name-change-modal { z-index: 1050; position: fixed; max-width: none; width: 100%; padding: 0; background: transparent; box-shadow: none; border-radius: 0; }
                </style>
            <div class="container mt-4">
                <div class="row">
                    <div class="col-lg-2 mb-2">
                        {% include ('v2/Settings/Menu.twig') with {active: 'details'} %}
                    </div>
                    <div class="col-lg-10 mb-2">
                        <div class="card">
                            <div class="card-body">
                                <p class="mb-1" style="margin-bottom:0px;"><strong>Username: </strong>
                                    {{ data.user.username }}
                                    <a href="#" data-toggle="modal" data-target="#name-change-modal" style="color:inherit" title="Name Change">
                                        <i class="far align-middle fa-pen-square ml-1" style="float:right;margin-top:5px;"></i>
                                    </a>
                                </p>
                                <p style="margin-bottom: 0px;">
                                    <strong>E-mail: </strong>
                                    {{ data.user.email }}
                                    <a href="#ex1" rel="modal:open" style="color:inherit">
                                        <i class="far align-middle fa-pen-square ml-1" style="float:right;margin-top:5px;"></i>
                                    </a>
                                </p>
                            </div>
                        </div>
                        <div class="mt-3">
                            <form role="form" method="POST" action="/app/settings" enctype="multipart/form-data">
                                <input type="hidden" name="_token" value="{{ data.csrf_token }}">
                                <div class="form-group row">
                                    <label for="blurb" class="col-form-label text-md-right" style="margin-left:15px;">
                                        <h4 style="font-weight: 300;">Blurb</h4>
                                    </label>
                                    <div class="col-md-12">
                                        <textarea type="text" id="blurb" name="blurb" value="" placeholder="Blurb"
                                            class="form-control" rows="8">{{ data.user.blurb }}</textarea>
                                    </div>
                                    <label class="col-form-label text-md-right row"
                                        style="margin-left:15px;"><strong>Note:</strong>
                                        <p class="text-danger" style="margin:0 3px 0 3px">${myDius}</p> will be replaced with
                                        the amount of Dius you have.
                                    </label>
                                </div>
                                <div class="form-group col-md-2" style="margin-top: 40px; padding-left: 0px;">
                                    <button type="submit" class="btn btn-success ">update</button>
                                </div>
                            </form>
                        </div>
                        <div class="mt-3">
                            <h4 style="font-weight: 300;">Gender</h4>
                            <form role="form" method="POST" action="/app/settings">
                                <input type="hidden" name="_token" value="{{ data.csrf_token }}">
                                <select name="gender" class="form-control" onchange="this.form.submit();">
                                    <option value="m"{{ (data.user.gender ?? 'm') in ['m', ''] ? ' selected' : '' }}>Male</option>
                                    <option value="f"{{ data.user.gender == 'f' ? ' selected' : '' }}>Female</option>
                                    <option value="n"{{ data.user.gender == 'n' ? ' selected' : '' }}>Don't show</option>
                                </select>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
    </div>
	<div class="modal fade" id="name-change-modal" tabindex="-1" role="dialog" aria-labelledby="name-change-title" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <form class="modal-content" role="form" method="POST" action="/app/settings">
                <input type="hidden" name="_token" value="{{ data.csrf_token }}">
                <div class="modal-header">
                    <h4 class="modal-title" id="name-change-title">Name Change</h4>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="form-group mb-0">
                        <label for="new_username"><strong>New Name</strong></label>
                        <input type="text" id="new_username" name="new_username" value="{{ data.user.username }}" required minlength="3" maxlength="20" pattern="[A-Za-z0-9_]+" class="form-control" autocomplete="off">
                        <small class="form-text">It costs {{ data.nameChange.cost }} Dius to change your name, unless you only want to change capitalization.</small>
                        {% if data.nameChange.next %}<small class="form-text text-muted">You can change your username again on {{ data.nameChange.next }}.</small>{% endif %}
                    </div>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-link text-danger" data-dismiss="modal">cancel</button>
                    <button type="submit" class="btn btn-outline-primary">change</button>
                </div>
            </form>
        </div>
    </div>
	<div id="ex1" class="modal container" style="padding:0">
            <div class="container" style="padding:0">
                <div class="card" style="">
                    <div class="card-header" style="display: flex; align-items: center;">
                        <a href="#close-modal" rel="modal:close" style="margin-right: 5px;">
                            <button class="btn btn-{{ (data.user.theme == "night") ? "secondary" : "light" }}">
                                <i class="far fa-chevron-left"></i>
                            </button>
                        </a>
                        <p style="margin: 0;">Change Email</p>
                    </div>
                    <div class="card-body">
                        <form role="form" method="POST" action="/app/settings">
                            <input type="hidden" name="_token" value="{{ data.csrf_token }}">
                            <div class="form-group row">
                                <div class="col-md-12">
                                    <label for="email" class="col-form-label">New E-mail</label>
                                    <input type="email" name="email" value="" placeholder="New E-mail" required class="form-control">
                                    <label for="password" class="col-form-label">Confirm Password</label>
                                    <input type="password" name="password" value="" placeholder="Password" required class="form-control">
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary full-width">Change</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    {% include ('v2/Modules/footer.twig') %}
  </body>
</html>