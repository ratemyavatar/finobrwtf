<html>
  <head>
    {% include ('v2/Modules/head.twig') %}
  </head>
  <body>
    <div id="app">
      {% include ('v2/Modules/nav.twig') %}
      <div class="container mt-4">
                <div class="row">
                    <div class="col-lg-2 mb-2">
                        {% include ('v2/Settings/Menu.twig') with {active: 'language'} %}
                    </div>
                    <div class="col-lg-10 mb-2">
                        <h4 style="font-weight: 300;">Language</h4>
                        <form role="form" method="POST" action="/app/language">
                            <input type="hidden" name="_token" value="{{ data.csrf_token }}">
                            <select name="locale" class="form-control" onchange="this.form.submit();">
                                {% for code, name in data.languages %}
                                    <option value="{{ code }}"{{ data.locale == code ? ' selected' : '' }}>{{ name }}</option>
                                {% endfor %}
                            </select>
                        </form>
                    </div>
                </div>
            </div>
    </div>
    {% include ('v2/Modules/footer.twig') %}
  </body>
</html>
