<html>
  <head>
    {% include ('v2/Modules/head.twig') %}
  </head>
  <body>
    <div id="app">
      {% include ('v2/Modules/nav.twig') %}
      <div class="container mt-4">
        <div class="row">
          <div class="col-md-10 offset-md-1">
            <div class="card">
              <div class="card-header">
                Trades
              </div>
              <div class="card-body">
                {% if data.trades|length %}
                <table class="table table-striped table-responsive mt-2 mb-0">
                  <thead class="thead-dark">
                    <tr>
                      <th style="width: 20%">Date</th>
                      <th style="width: 35%">Partner</th>
                      <th style="width: 25%">Status</th>
                      <th style="width: 20%"></th>
                    </tr>
                  </thead>
                  <tbody>
                    {% for t in data.trades %}
                    <tr>
                      <td title="{{ t.datetime }}">
                        {{ t.date }}
                      </td>
                      <td>
                        {% if t.partner %}
                        <a href="/user/{{ t.partner.id }}">
                          <img src="{{ t.partner.pfp ? 'https://cdn.finobe.wtf/' ~ t.partner.pfp : '/s/img/spinnerv2.gif' }}" alt="{{ t.partner.username }}" class="mr-1" style="height: 20px">
                          {{ t.partner.username }}
                        </a>
                        {% else %}
                        <span class="text-muted">[deleted]</span>
                        {% endif %}
                      </td>
                      <td>
                        {% if t.status == 'pending' %}
                          Pending (<i>{{ t.incoming ? 'Incoming' : 'Outgoing' }}</i>)
                        {% elseif t.status == 'accepted' %}
                          <span class="text-success">Accepted</span>
                        {% elseif t.status == 'declined' %}
                          <span class="text-danger">Declined</span>
                        {% elseif t.status == 'revoked' %}
                          <span class="text-muted">Revoked</span>
                        {% else %}
                          <span class="text-muted">Inactive</span>
                        {% endif %}
                      </td>
                      <td>
                        <a href="/trade/info/{{ t.id }}">View Details</a>
                      </td>
                    </tr>
                    {% endfor %}
                  </tbody>
                </table>
                {% if data.pagination.pages > 1 %}
                {% set pg = data.pagination.page %}
                <div class="mt-2 mb-0">
                  <ul class="pagination d-flex flex-wrap">
                    {% if pg > 1 %}<li class="page-item"><a class="page-link" href="/trades?page={{ pg - 1 }}" rel="prev">&laquo;</a></li>{% else %}<li class="page-item disabled"><span class="page-link">&laquo;</span></li>{% endif %}
                    {% for i in 1..data.pagination.pages %}
                      {% if i == pg %}<li class="page-item active"><span class="page-link">{{ i }}</span></li>{% else %}<li class="page-item"><a class="page-link" href="/trades?page={{ i }}">{{ i }}</a></li>{% endif %}
                    {% endfor %}
                    {% if pg < data.pagination.pages %}<li class="page-item"><a class="page-link" href="/trades?page={{ pg + 1 }}" rel="next">&raquo;</a></li>{% else %}<li class="page-item disabled"><span class="page-link">&raquo;</span></li>{% endif %}
                  </ul>
                </div>
                {% endif %}
                {% else %}
                <p class="text-center p-3 m-0">No trades are available</p>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    {% include ('v2/Modules/footer.twig') %}
  </body>
</html>
