<html>
  <head>
    {% include ('v2/Modules/head.twig') %}
	<style>
		.video-index__thumbnail {
		    width: 100%;
		    margin-left: auto;
		    margin-right: auto;
		    background: #000;
		}

		.h-100 {
			height: 100%;
		}

		.video-card:hover {
			text-decoration: none;
			color: inherit;
		}
</style>
  </head>
  <body>
    <div id="app">
   {% include ('v2/Modules/nav.twig') %}
   <div class="container mt-3">
      <h3 class="font-weight-light mb-0">Videos</h3>
	  {% if not data.siteusername %}
      <p class="mb-0"><strong>Note:</strong> More videos may be available after logging in.</p>
	  {% endif %}
      <div class="mb-4"></div>
      {% if not data.videos.data|length %}
	  <p>No results</p>
	  {% endif %}

	  {% for videosBatch in data.videos.data|batch(6) %}
			<div class="container-fluid content-row d-block d-md-none">
				<div class="row">
					{% for video in videosBatch %}
						<div class="col-lg-2 mb-4">
							<a href="/video/{{ video.id }}" alt="{{ video.title }}" class="game-card h-100 video-card">
								<span class="thumbnail"><img src="/video/thumb/{{ video.id }}" alt="{{ video.title }}" class="card-img-top"></span>
								<span class="data py-2 px-2 d-flex flex-column">
									<span class="catalog-no-overflow-plz">{{ video.title }}</span>
									<span class="catalog-no-overflow-plz text-muted">{{ video.author }}</span>
								</span>
							</a>
						</div>
					{% endfor %}
				</div>
			</div>
		{% endfor %}
	  {% for videosBatch in data.videos.data|batch(6) %}
			<div class="container-fluid content-row d-none d-md-block d-lg-none">
				<div class="row">
					{% for video in videosBatch %}
						<div class="col-lg-2 mb-4">
							<a href="/video/{{ video.id }}" alt="{{ video.title }}" class="game-card h-100 video-card">
								<span class="thumbnail"><img src="/video/thumb/{{ video.id }}" alt="{{ video.title }}" class="card-img-top"></span>
								<span class="data py-2 px-2 d-flex flex-column">
									<span class="catalog-no-overflow-plz">{{ video.title }}</span>
									<span class="catalog-no-overflow-plz text-muted">{{ video.author }}</span>
								</span>
							</a>
						</div>
					{% endfor %}
				</div>
			</div>
		{% endfor %}
		{% for videosBatch in data.videos.data|batch(6) %}
			<div class="container-fluid content-row d-none d-lg-block">
				<div class="row">
					{% for video in videosBatch %}
						<div class="col-lg-2 mb-4">
							<a href="/video/{{ video.id }}" alt="{{ video.title }}" class="game-card h-100 video-card">
								<span class="thumbnail"><img src="/video/thumb/{{ video.id }}" alt="{{ video.title }}" class="card-img-top"></span>
								<span class="data py-2 px-2 d-flex flex-column">
									<span class="catalog-no-overflow-plz">{{ video.title }}</span>
									<span class="catalog-no-overflow-plz text-muted">{{ video.author }}</span>
								</span>
							</a>
						</div>
					{% endfor %}
				</div>
			</div>
		{% endfor %}
	  <div class="my-4">
        <ul class="pagination shadow-sm">
			<li class="page-item{{ (data.videos.pages.info.current_page <= 1) ? " disabled" : "" }}">
			  <a class="page-link" id="previous-page" href="/videos?page={{ data.videos.pages.info.previous_page }}" rel="previous" aria-label="Previous <<">«</a>
			</li>
			{% if data.videos.pages.info.start_page > 1 %}
			  <li class="page-item">
				<a class="page-link" href="/videos?page=1">1</a>
			  </li>
			  {% if data.videos.pages.info.start_page > 2 %}
				<li class="page-item">
				  <a class="page-link" href="/videos?page=2">2</a>
				</li>
			  {% endif %}
			  <li class="page-item disabled"><span class="page-link">...</span></li>
			{% endif %}
			{% for page in data.videos.pages.data %}
			  <li class="page-item">
				<a class="page-link{{ (page.page == data.videos.pages.info.current_page) ? " selected" : "" }}" href="/videos?page={{ page.page }}">
				  {{ page.page }}
				</a>
			  </li>
			{% endfor %}
			{% if data.videos.pages.info.end_page < data.videos.pages.info.number_of_pages %}
			  {% if data.videos.pages.info.end_page + 1 < data.videos.pages.info.number_of_pages %}
				<li class="page-item disabled"><span class="page-link">...</span></li>
			  {% endif %}
			  <li class="page-item">
				<a class="page-link" href="/videos?page={{ data.videos.pages.info.number_of_pages - 1 }}">{{ data.videos.pages.info.number_of_pages - 1 }}</a>
			  </li>
			  <li class="page-item">
				<a class="page-link" href="/videos?page={{ data.videos.pages.info.number_of_pages }}">{{ data.videos.pages.info.number_of_pages }}</a>
			  </li>
			{% endif %}
			<li class="page-item{{ (data.videos.pages.info.current_page >= data.videos.pages.info.number_of_pages) ? " disabled" : "" }}">
			  <a class="page-link" id="next-page" href="/videos?page={{ data.videos.pages.info.next_page }}" rel="next" aria-label="Next >>">»</a>
			</li>
		  </ul>
        </div>
   </div>
</div>
    {% include ('v2/Modules/footer.twig') %}
  </body>
</html>