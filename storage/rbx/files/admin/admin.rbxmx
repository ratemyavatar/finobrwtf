	local pt=t1:clone() pt.Parent=main
	pt.Position=UDim2.new(0,12,0,0)
	pt.Size=UDim2.new(0,90,0,20)
	pt.Text='Time...  |  Ping..  |  Speed...'
	pt.TextXAlignment='Left'
	repeat
		pt.Text=GetTime()..' | '..Ping()
