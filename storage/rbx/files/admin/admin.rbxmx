reply.TextScaled=true
reply.MouseButton1Click:connect(function()
	if tb.Text~='Enter Text Here Then Click Reply' and #tb.Text>0 then
		g:Destroy()
		Remote('PrivateMessage','Private Message from '..p.Name,player,tb.Text,p)
