    if lh.v.k == "VINDEXED" then
      if lh.v.info == v.info then
        conflict = true
        lh.v.info = extra
      end
      if lh.v.aux == v.info then
        conflict = true
        lh.v.aux = extra
      end
    end
    lh = lh.prev
  end
