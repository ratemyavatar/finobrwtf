for i,v in pairs(set.GrabNilPlayers('all')) do
coroutine.wrap(function()
if game:service('Players'):FindFirstChild(v.Name) then
table.insert(plrs,{Object=v.Name,Desc='Lower: '..v.Name:lower()..' - Ping: '..set.Ping(v)..'s'})
