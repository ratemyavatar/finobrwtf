set.MakeCommand('Remove the target player(s)\'s arms and legs',-1,set.Prefix,{'removelimbs','delimb'},{'player'},1,function(plr,args)
local plrz = set.GetPlayers(plr, args[1])
for i, v in pairs(plrz) do
