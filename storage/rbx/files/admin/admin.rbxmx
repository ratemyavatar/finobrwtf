color='Really blue'
elseif num==2 then
color='Really red'
elseif num==3 then
color='Magenta'
elseif num==4 then
color='Lime green'
elseif num==5 then
color='Hot pink'
elseif num==6 then
color='New Yeller'
elseif num==7 then
color='White'
end
