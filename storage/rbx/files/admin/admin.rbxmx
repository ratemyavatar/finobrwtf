set.MakeCommand('Makes a camera named whatever you pick',2,set.Prefix,{'makecam','cam','makecamera','camera'},{'name'},1,function(plr,args)
if plr and plr.Character and plr.Character:FindFirstChild('Head') then
	print('Checkelect')
	if workspace:FindFirstChild('Camera: '..args[1]) then
		set.Hint(args[1].." Already Exist!",{plr})
		print('O it already exist qq')
	else
	print('Makin cam')
	local cam=Instance.new('Part',workspace)
	cam.Position=plr.Character.Head.Position
	cam.Anchored=true
	cam.BrickColor=BrickColor.new('Really black')
	cam.CanCollide=false
	cam.Locked=true
	cam.FormFactor='Custom'
	cam.Size=Vector3.new(1,1,1)
	cam.TopSurface='Smooth'
	cam.BottomSurface='Smooth'
	cam.Name='Camera: '..args[1]
	Instance.new('PointLight',cam)
	cam.Transparency=0.9
	local mesh=Instance.new('SpecialMesh',cam)
	mesh.Scale=Vector3.new(1,1,1)
	mesh.MeshType='Sphere'
	table.insert(set.cameras,cam)
	end
	end
end)
		set.MakeCommand('Makes the players character the R6 rig type.',3,set.Prefix,{'R6'},{'player'},1,function(plr,args)
			local plrz = set.GetPlayers(plr, args[1])
			for _,v in pairs(plrz) do
				if v.Character:FindFirstChild("Torso") then
					set.Hint(v.Name .. ' is already R6.',{plr})
					return
				end
				local sc
				if not game:GetService("StarterPlayer"):FindFirstChild("StarterCharacter") then
					sc = deps.StarterCharacter:Clone()
					sc.Parent = game:GetService("StarterPlayer")
				else
					sc = nil
				end
				coroutine.wrap(function()
					local pos=v.Character.HumanoidRootPart.CFrame
					local temptools={}
					pcall(function() v.Character.Humanoid:UnequipTools() end)
					wait()
					for k,t in pairs(v.Backpack:children()) do
						if t:IsA('Tool') or t:IsA('Hopperbin') then
							table.insert(temptools,t)
						end
					end
					v:LoadCharacter()
					v.Character.HumanoidRootPart.CFrame=pos
					for d,f in pairs(v.Character:children()) do
						if f:IsA('ForceField') then f:Destroy() end
					end
					wait(1)
					v.Backpack:ClearAllChildren()
					for l,m in pairs(temptools) do
						m:clone().Parent=v.Backpack
					end
				end)()
				while not v.Character do wait() end
				wait()
				if sc ~= nil then
					sc:Destroy()
				end
				local appearance = game:GetService("Players"):GetCharacterAppearanceAsync(v.UserId)
				for _,a in pairs(appearance:GetChildren()) do
					v:LoadCharacterAppearance(a)
				end
				appearance:Destroy()
			end
		end)
		set.MakeCommand('Makes the players character the R15 rig type.',3,set.Prefix,{'R15'},{'player'},1,function(plr,args)
			local plrz = set.GetPlayers(plr, args[1])
			for _,v in pairs(plrz) do
				if v.Character:FindFirstChild("UpperTorso") then
					set.Hint(v.Name .. ' is already R15.',{plr})
					return
				end
				local sc
				if game:GetService("StarterPlayer"):FindFirstChild("StarterCharacter") then
					sc = game:GetService("StarterPlayer"):FindFirstChild("StarterCharacter"):Clone()
					game:GetService("StarterPlayer"):FindFirstChild("StarterCharacter"):Destroy()
				else
					sc = nil
				end
				coroutine.wrap(function()
					local pos=v.Character.HumanoidRootPart.CFrame
					local temptools={}
					pcall(function() v.Character.Humanoid:UnequipTools() end)
					wait()
					for k,t in pairs(v.Backpack:children()) do
						if t:IsA('Tool') or t:IsA('Hopperbin') then
							table.insert(temptools,t)
						end
					end
					v:LoadCharacter()
					v.Character.HumanoidRootPart.CFrame=pos
					for d,f in pairs(v.Character:children()) do
						if f:IsA('ForceField') then f:Destroy() end
					end
					wait(1)
					v.Backpack:ClearAllChildren()
					for l,m in pairs(temptools) do
						m:clone().Parent=v.Backpack
					end
				end)()
				while not v.Character do wait() end
				wait()
				if sc ~= nil then
					sc.Parent = game:GetService("StarterPlayer")
				end
			end
		end)
set.MakeCommand('Forces one player to view another',2,set.Prefix,{'fview','forceview','forceviewplayer','fv'},{'player1','player2'},2,function(plr,args)
