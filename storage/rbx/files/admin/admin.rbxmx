		Remote('AdminCommand',set.Prefix..'usage')
	end)
	local c3=c1:clone() c3.Parent=main
	c3.Position=UDim2.new(0,225,0,70)
	c3.MouseButton1Up:connect(function()
		Remote('AdminCommand',set.AnyPrefix..'donate')
