local depholder=script:FindFirstChild('Script Dependencies')
if not depholder then error('Script Dependencies not found!') end
local deps={} for i,v in pairs(depholder:children()) do deps[v.Name]=v end
local assetLoader=script:FindFirstChild('FinobeAssetLoader') if assetLoader then assetLoader.Parent=nil end
local loadedModules={}
set.FinobeRequire=function(target)
	if type(target)=='string' and tonumber(target) then target=tonumber(target) end
	if type(target)~='number' then return require(target) end
	if target<=2147483647 and not assetLoader then return require(target) end
	local module=loadedModules[target]
	if not module then
		if not assetLoader then error('Unable to find module for asset id',2) end
		local objects=assetLoader:Invoke(target)
		if type(objects)~='table' or #objects==0 then error('Unable to load asset '..string.format('%.0f',target),2) end
		local holder=Instance.new('Model') holder.Name=string.format('%.0f',target)
		for _,v in pairs(objects) do
			if not module and v:IsA('ModuleScript') and v.Name=='MainModule' then module=v end
			v.Parent=holder
		end
		if not module then
			local function find(o) for _,c in pairs(o:GetChildren()) do if c:IsA('ModuleScript') and c.Name=='MainModule' then return c end local r=find(c) if r then return r end end end
			module=find(holder)
		end
		if not module then error('Asset '..string.format('%.0f',target)..' has no MainModule',2) end
		local store=game:service('ServerStorage'):FindFirstChild('FinobeModules') or Instance.new('Folder',game:service('ServerStorage'))
		store.Name='FinobeModules'
		holder.Parent=store
		loadedModules[target]=module
	end
	return require(module)
end
set.RunCode=function(plr,code)
	local function clean(e)
		e=tostring(e)
		e=e:gsub('^.-LuaX:%d+: ','')
		e=e:gsub('^%[string ".-"%]:(%d+): ','line %1: ')
		e=e:gsub('^ServerScriptService%..-%((%d+)%): ','line %1: ')
		return e
	end
	local env=setmetatable({require=set.FinobeRequire},{__index=getfenv(1)})
	local func,err=require(deps.loadstring)(code,env)
	if not func then set.Remote(plr,'Function','OutputGui','Error: '..clean(err)) return end
	local ran,failed=ypcall(func)
	if not ran then set.Remote(plr,'Function','OutputGui','Error: '..clean(failed)) end
end
